# --- Database ---
DATABASE_URL=postgresql://telecomm:telecomm@localhost:5432/telecomm

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Auth ---
AUTH_SECRET=dev-secret-change-me
SESSION_COOKIE_NAME=telecomm_session

# --- API <-> Web ---
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
WEB_URL=http://localhost:3000

# --- Widget identity verification ---
WIDGET_HMAC_SECRET=dev-widget-secret-change-me

# --- AI (stub until keys are added) ---
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

# --- Email ---
# SMTP credentials are PLATFORM-level and shared by every workspace. The brand
# each email is sent as comes from that workspace's settings.smtpFromAddress,
# never from here. SMTP_FROM is only the fallback for platform-level mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# One Postmark server serves every workspace. This is its single inbound
# address; brands forward their own support address to it and the inbound
# webhook resolves the workspace from the recipient.
POSTMARK_SERVER_TOKEN=
POSTMARK_INBOUND_ADDRESS=

# Inbound webhook authentication. Postmark has no payload signature, so it
# authenticates with Basic credentials embedded in the webhook URL:
#   https://USER:PASS@your-api-host/inbound/email
# Required in production — the API refuses inbound mail without it.
POSTMARK_WEBHOOK_USER=
POSTMARK_WEBHOOK_PASS=
# Alternative to Basic auth for proxies that strip credentials:
# sent as `Authorization: Bearer <token>` or `X-Webhook-Token: <token>`.
POSTMARK_WEBHOOK_TOKEN=

# --- Object storage (stub until keys are added) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
